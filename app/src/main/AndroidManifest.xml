<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permesso per attivare/disattivare la modalità Non Disturbare -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Permesso WakeLock per mantenere attivo il processore a schermo spento durante la meditazione -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permessi per il servizio in background (Timer a schermo spento) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Permessi ufficiali Android 14+ (System Health Connect) -->
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" />

    <!-- Permessi di compatibilità per Android 13 e precedenti / App Health Connect -->
    <uses-permission android:name="androidx.health.permission.Mindfulness.WRITE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Still">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Still"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Richiesto da Health Connect su Android 13 e precedenti per l'informativa sui permessi -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Richiesto da Health Connect su Android 14+ con protezione START_VIEW_PERMISSION_USAGE -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Servizio in background per ricevere i dati della meditazione da dispositivi Wear OS -->
        <service
            android:name=".WearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/meditation_completed" />
            </intent-filter>
        </service>

        <service
            android:name=".StillTimerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

</manifest>